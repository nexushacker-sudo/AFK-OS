# AFK OS Plymouth theme - centered logo and progress bar
Window.SetBackgroundTopColor(0.015, 0.025, 0.10);
Window.SetBackgroundBottomColor(0.00, 0.12, 0.38);

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
logo_sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo_image.GetHeight() / 2 - 35);
logo_sprite.SetZ(100);

bar_width = 460;
bar_height = 16;
bar_x = Window.GetX() + Window.GetWidth() / 2 - bar_width / 2;
bar_y = Window.GetY() + Window.GetHeight() / 2 + 145;

bar_bg_image = Image("progress-bg.png");
bar_bg_sprite = Sprite(bar_bg_image);
bar_bg_sprite.SetX(bar_x);
bar_bg_sprite.SetY(bar_y);
bar_bg_sprite.SetZ(110);

bar_fill_image = Image("progress-fill.png");
bar_fill_sprite = Sprite();
bar_fill_sprite.SetX(bar_x);
bar_fill_sprite.SetY(bar_y);
bar_fill_sprite.SetZ(111);

fun update_progress (progress) {
    if (progress < 0) progress = 0;
    if (progress > 1) progress = 1;
    width = Math.Int(bar_width * progress);
    if (width > 0) {
        bar_fill_sprite.SetImage(bar_fill_image.Scale(width, bar_height));
    }
}

fun boot_progress_callback (duration, progress) {
    update_progress(progress);
}

fun progress_callback (duration, progress) {
    update_progress(progress);
}
